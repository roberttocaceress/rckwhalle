<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityTecnico">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Voltar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analise/Ajuste técnico"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginBottom="1dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque em uma das opções"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_update_tabela_rck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente30"
                android:gravity="center"
                android:text="Atualizar tabela(s) RCK"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_update_tabela_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente50"
                android:gravity="center"
                android:text="Atualizar tabelas(s) APP"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_update_indice_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente30"
                android:gravity="center"
                android:text="Atualizar indice(s) APP"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_lista_tabela_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente50"
                android:gravity="center"
                android:text="TABELAS DO APP"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_lista_usuario_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente30"
                android:gravity="center"
                android:text="Lista de usuários do APP"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:background="@color/branco"
            android:elevation="12dp">

            <Button
                android:id="@+id/btn_tecnico_lista_pedido_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryTransparente50"
                android:gravity="center"
                android:text="Lista de pedidos exportados"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>