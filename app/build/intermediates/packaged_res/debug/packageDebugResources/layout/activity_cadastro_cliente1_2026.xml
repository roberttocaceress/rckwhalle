<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".activity.CadastroClienteMain">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroolView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD 1: IDENTIFICAÇÃO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ID do Cliente Interno -->
                    <TextView
                        android:id="@+id/txtId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="12dp"
                        android:drawableStart="@drawable/ic_id_card_2026"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="Id: 0000"
                        android:textColor="@color/preto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableTint="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Tipo de Pessoa"
                        android:textColor="@color/preto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rdPessoa"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/branco"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <RadioButton
                            android:id="@+id/rdFisica"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_radio_pessoa_2026"
                            android:button="@null"
                            android:gravity="center"
                            android:text="F - FÍSICA"
                            android:textColor="@color/text_radio_pessoa_2026"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rdJuridica"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_radio_pessoa_2026"
                            android:button="@null"
                            android:gravity="center"
                            android:text="J - JURÍDICA"
                            android:textColor="@color/text_radio_pessoa_2026"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/txtNomeCliente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome / Razão Social *"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeCliente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^*()+-/\~.:?= çÇÁáÃãÂâÀàÄäÉéÊêÈèËëÍíÌìÏïÎîÓóÕõÔôÒòÖöÚúÛûÙùÜü"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:maxLength="60"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome Fantasia *"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeFantasia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^*()+-/\~.:?= çÇÁáÃãÂâÀàÄäÉéÊêÈèËëÍíÌìÏïÎîÓóÕõÔôÒòÖöÚúÛûÙùÜü"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtCpfCnpj"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="CPF / CNPJ"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCpfCnpj"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textFilter|textMultiLine"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Data"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="date|textMultiLine"
                            android:text="  /  /    "
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD 2: CLASSIFICAÇÃO E FISCAL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Categoria"
                        android:textColor="@color/preto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_com_seta" />

                    <TextView
                        android:id="@+id/txtSegmento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Segmento/Setor"
                        android:textColor="@color/preto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spSegmento"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_com_seta" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Tipo Inscrição Estadual"
                        android:textColor="@color/preto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spIe"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_spinner_com_seta" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Inscrição Estadual"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtInscEstadual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textFilter|numberSigned|textMultiLine"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD 3: CONTATOS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Telefone Principal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Telefone Principal"
                            android:textColorHint="@color/preto"
                            app:hintTextColor="@color/preto">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTelefonePrincipal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone|textMultiLine"
                                android:textColor="@color/preto" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnLigar1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@mipmap/ic_telefone" />
                    </LinearLayout>

                    <!-- Telefone 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Telefone I"
                            android:textColorHint="@color/preto"
                            app:hintTextColor="@color/preto">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTelefone1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone|textMultiLine"
                                android:textColor="@color/preto" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnLigar2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@mipmap/ic_telefone" />
                    </LinearLayout>

                    <!-- Telefone 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Telefone II"
                            android:textColorHint="@color/preto"
                            app:hintTextColor="@color/preto">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTelefone2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone|textMultiLine"
                                android:textColor="@color/preto" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnLigar3"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@mipmap/ic_telefone" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Pessoa de Contato"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPessoaContato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="E-mail Principal"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEmailPrincipal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress|textMultiLine"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/colorPrimary"
                android:letterSpacing="0.05"
                android:text="CONTINUAR 1/5"
                android:textAllCaps="true"
                android:textColor="@color/branco"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_main_avancar_new"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/branco" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
