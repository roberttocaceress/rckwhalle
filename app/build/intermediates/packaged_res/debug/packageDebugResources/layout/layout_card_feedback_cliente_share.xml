<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PARTICIPAÇÃO DO CLIENTE (6 MESES)"
            android:textColor="@color/colorText"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNomeClienteShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CLIENTE EXEMPLO LTDA"
            android:textAlignment="center"
            android:textColor="#673AB7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvValorTotalCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Total no mês: R$ 8.450,00"
            android:textColor="@color/colorText"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/tvSharePorcentagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18.5%"
            android:textColor="#673AB7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="da sua carteira nos últimos 6 meses"
            android:textColor="@color/colorText"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/pbShareCliente"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:progress="18"
            android:progressTint="#673AB7"
            android:scaleY="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* Valores sujeitos a alteração após faturamento, cancelamentos ou exclusões."
            android:textAlignment="center"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="italic" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
