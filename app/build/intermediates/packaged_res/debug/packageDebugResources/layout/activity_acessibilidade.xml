<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityAcessibilidade">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:gravity="center_horizontal"
        android:minHeight="?attr/actionBarSize"
        android:textAlignment="center"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title=" ">

        <ImageView
            android:id="@+id/imgView"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/outline_format_size_24"
            android:visibility="visible"
            tools:layout_editor_absoluteX="194dp"
            tools:layout_editor_absoluteY="16dp" />


    </androidx.appcompat.widget.Toolbar>

    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/borda_botao_text"
        android:backgroundTint="@color/branco"
        android:text="Cancelar"
        android:textColor="@color/colorText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnConfirmar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="CONFIRMAR ALTERAÇÂO"
        android:textColor="@color/branco"
        app:layout_constraintBottom_toTopOf="@+id/btnCancelar"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/lytFontePadrao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/borda_botao_tamanho_fonte"
        android:backgroundTint="@color/colorPrimary"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">


        <ImageView
            android:id="@+id/imgTamanhoPadrao"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/colorPrimary"
            app:srcCompat="@drawable/outline_format_size_24_app"
            />

        <TextView
            android:id="@+id/txvTamanhoPadrao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Tamanho padrão"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="16sp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytFonteMedio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/borda_botao_tamanho_fonte"
        android:backgroundTint="@color/colorPrimary"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@+id/lytFontePadrao"
        app:layout_constraintStart_toStartOf="@+id/lytFontePadrao"
        app:layout_constraintTop_toBottomOf="@+id/lytFontePadrao">


        <ImageView
            android:id="@+id/imgTamanhoMedio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/colorPrimary"
            app:srcCompat="@drawable/outline_format_size_36_36" />

        <TextView
            android:id="@+id/txvTamanhoMedio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Tamanho médio"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="18sp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytFonteGrande"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/borda_botao_tamanho_fonte"
        android:backgroundTint="@color/colorPrimary"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@+id/lytFonteMedio"
        app:layout_constraintStart_toStartOf="@+id/lytFonteMedio"
        app:layout_constraintTop_toBottomOf="@+id/lytFonteMedio">


        <ImageView
            android:id="@+id/imgTamanhoGrande"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/colorPrimary"
            app:srcCompat="@drawable/outline_format_size_48_48" />

        <TextView
            android:id="@+id/txvTamanhoGrande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Tamanho grande"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="20sp" />


    </LinearLayout>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:textColor="@color/preto"
        android:gravity="center"
        android:text="Escolha um tamanho de fonte para o aplicativo!"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirmar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytFonteGrande" />


</androidx.constraintlayout.widget.ConstraintLayout>