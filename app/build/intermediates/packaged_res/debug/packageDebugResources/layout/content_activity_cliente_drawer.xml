<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_cliente"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@color/branco"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:layout_editor_absoluteY="25dp"
    tools:showIn="@layout/app_bar_activity_cliente_drawer">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tb_cliente"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Pesquisar cliente(s)"
        tools:context=".activity.ActivityClienteDrawer">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/buscaCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            app:queryHint="Nome/código"
            app:showAsAction="always" />

        <ImageView
            android:id="@+id/helpCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginRight="4dp"
            android:background="@drawable/ic_help_new" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/edtTotalClientes"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/tb_cliente" />

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:elevation="48dp"
        app:layout_constraintBottom_toTopOf="@+id/edtTotalClientes"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnInserirCliente"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/style_button_2025"
            android:elevation="24dp"
            android:gravity="center_horizontal|center_vertical"
            android:text="+"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="25sp" />

        <LinearLayout
            android:id="@+id/lytInserirCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/btnInserirCliente"
            android:layout_marginEnd="-30dp"
            android:layout_marginRight="-30dp"
            android:layout_marginBottom="6dp"
            android:layout_toStartOf="@+id/btnInserirCliente"
            android:layout_toLeftOf="@+id/btnInserirCliente"
            android:background="@drawable/borda_edittext_preto_transparente"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginLeft="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginRight="30dp"
                android:text="Novo cliente "
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

        </LinearLayout>


    </RelativeLayout>

    <EditText
        android:id="@+id/edtTotalClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="4dp"
        android:background="@color/branco"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:text="total"
        android:textColor="@color/preto"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/cardFinalizarInclusao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/cardFinalizarInclusao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnFinalizarInclusao"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:drawableTop="@drawable/ic_cancelar"
            android:text="CANCELAR"
            android:textColor="@color/branco"
            android:textSize="10dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
