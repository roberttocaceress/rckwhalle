<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_produto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@color/branco"

    tools:context=".activity.ActivityEstoqueSaldo">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tb_estoque_saldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        android:theme="@style/Theme.Toolbar"
        app:title="Consulta estoque"
        tools:context=".activity.ActivityEstoqueSaldo">
        <ImageView
            android:id="@+id/helpEstoqueSaldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/ic_help_new"
            android:layout_marginRight="4dp"/>

    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saldo de estoque"
        android:textAlignment="center"
        android:textColor="@color/preto"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/listaEstoque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaEstoqueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"

            android:background="@color/branco" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:gravity="center"
        android:text="Aguarde enquanto pesquisamos os dados..."
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="12sp"
        android:visibility="invisible"
        tools:text="Aguarde enquanto pesquisamos os dados..." />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_menu"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Informe o(s) tipo(s) de filtro(s) "
                android:textAlignment="center"
                android:textColor="@color/preto" />
            <EditText
                android:id="@+id/edt_nome_produto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:hint="Nome do produto"
                android:text=""
                android:textAlignment="textStart"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edt_codigo_produto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:hint="Código"
                    android:text=""
                    android:textAlignment="textStart"
                    android:textColor="@color/preto"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/edt_ean_produto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:hint="(EAN)"
                    android:text=""
                    android:textAlignment="textStart"
                    android:textColor="@color/preto"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txv_grupo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Grupo"
                        android:textColor="@color/preto"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/sp_grupo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txv_deposito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Deposito"
                        android:textColor="@color/preto"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/sp_deposito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />


                </LinearLayout>
            </LinearLayout>



        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorPrimary">

        <ImageView
            android:id="@+id/img_view_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            app:srcCompat="@drawable/ic_action_arrow_up_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="Situação"
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">
                <CheckBox
                    android:id="@+id/chk_status_todos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:backgroundTint="@color/branco"
                    android:buttonTint="@color/branco"
                    android:text="Todos"
                    android:textColor="@color/branco"/>

                <CheckBox
                    android:id="@+id/chk_status_ativo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:backgroundTint="@color/branco"
                    android:buttonTint="@color/branco"
                    android:text="Ativo"
                    android:textColor="@color/branco"/>
                <CheckBox
                    android:id="@+id/chk_status_inativo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:backgroundTint="@color/branco"
                    android:buttonTint="@color/branco"
                    android:text="Inátivo"
                    android:textColor="@color/branco"/>

                <ImageView
                    android:id="@+id/img_view_avancar"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="8dp"
                    app:srcCompat="@drawable/ic_action_arrow_forward_white" />


            </LinearLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>