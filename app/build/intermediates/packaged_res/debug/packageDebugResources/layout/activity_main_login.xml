<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnAjuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/colorPrimary"
            android:drawableEnd="@drawable/ic_help_new"
            android:text="Ajuda"
            android:textAlignment="textEnd"
            android:textColor="@color/branco"
            android:textSize="12sp" />
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/txvBemVindo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:text="Olá. Seja bem vindo!\nInforme seu usuário/email e senha para prosseguir."
        android:textColor="@color/branco"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvBemVindo">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">




            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleTint="@color/branco"
                android:layout_marginTop="10dp"
                app:errorEnabled="true"
                app:counterEnabled="true"
                android:textColorHint="@color/branco">

                <EditText
                    android:id="@+id/edtLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:hint="Usuário/email"

                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/branco"
                    android:textColorLink="@color/branco"
                    android:textSize="20sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorEnabled="true"
                app:counterEnabled="true"

                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/branco"
                android:textColorHint="@color/branco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLogin"
                    android:layout_centerInParent="true"
                    android:textSize="20sp"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:textColorHint="@color/branco"
                    android:textColor="@color/branco"
                    />

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/colorPrimary"
                android:drawableBottom="@drawable/ic_main_avancar_new"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btnBiometria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/colorPrimary"
                android:drawableTop="@drawable/ic_main_avancar_biometria_foreground"
                android:text="Login biométrico"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"

                android:visibility="invisible" />

            <TextView
                android:id="@+id/progressTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Aguarde enquanto validadamos os dados informádos..."
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="10sp"
                android:visibility="invisible"/>


            <Button
                android:id="@+id/btnInformacoesApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:drawableTop="@drawable/ic_ajuda_informacoes_new"
                android:gravity="center"
                android:textAlignment="center"
                android:text="Informações do app"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/branco"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRecuperarSenha1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/colorPrimary"
                    android:text="Esqueceu a senha? "
                    android:textAlignment="textEnd"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@color/branco" />

                <Button
                    android:id="@+id/btnRecuperarSenha2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/colorPrimary"
                    android:text="@string/underlined_text"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@color/branco" />
            </LinearLayout>
        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>