<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"
    android:background="@drawable/borda_layout_pedido">

    <LinearLayout
        android:id="@+id/itemView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0.1dp"
        android:layout_marginTop="0.1dp"
        android:layout_marginRight="0.1dp"
        android:layout_marginBottom="0.1dp"
        android:background="@drawable/borda_layout_pedido"

        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin_2"
        android:paddingTop="@dimen/activity_vertical_margin_2"
        android:paddingRight="@dimen/activity_horizontal_margin_2"
        android:paddingBottom="@dimen/activity_vertical_margin_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <RelativeLayout
                android:id="@+id/lyDadosCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgStatusCliente"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/ic_cliente_bloqueado" />

                <TextView
                    android:id="@+id/txtRazaoSocial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginEnd="2dp"
                    android:layout_toStartOf="@+id/imgStatusCliente"
                    android:layout_toLeftOf="@+id/imgStatusCliente"
                    android:layout_marginRight="2dp"
                    android:gravity="center_vertical"
                    android:text="Nome do Cliente"
                    android:textColor="#000000"
                    android:textSize="16dp"/>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/lyChamada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivChamada"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="-23dp"
                    android:background="@mipmap/ic_telefone" />

                <TextView
                    android:id="@+id/descricaoTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:text="Telefone" />

                <TextView
                    android:id="@+id/txtTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_alignParentStart="true"

                    android:layout_alignParentLeft="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="24dp"

                    android:layout_marginRight="24dp"

                    android:layout_marginBottom="2dp"
                    android:layout_toStartOf="@+id/ivChamada"
                    android:layout_toLeftOf="@+id/ivChamada"
                    android:ellipsize="end"
                    android:text="(67) 99324-5775" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/lyGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivGps"
                    android:layout_width="30dp"
                    android:layout_height="30dp"

                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="-23dp"
                    android:background="@mipmap/ic_localizacao" />

                <TextView
                    android:id="@+id/descricaoBairro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:text="Bairro" />

                <TextView
                    android:id="@+id/txtBairro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/descricaoBairro"
                    android:layout_alignParentStart="true"

                    android:layout_alignParentLeft="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="24dp"

                    android:layout_marginRight="24dp"

                    android:layout_marginBottom="2dp"
                    android:layout_toStartOf="@+id/ivGps"
                    android:layout_toLeftOf="@+id/ivGps"
                    android:ellipsize="end"

                    android:text="Nome do bairro" />

                <TextView
                    android:id="@+id/descricaoEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtBairro"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="2dp"
                    android:text="Endereço" />

                <TextView
                    android:id="@+id/txtEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/descricaoEndereco"
                    android:layout_alignParentStart="true"

                    android:layout_alignParentLeft="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="24dp"

                    android:layout_marginRight="24dp"

                    android:layout_marginBottom="2dp"
                    android:layout_toStartOf="@+id/ivGps"
                    android:layout_toLeftOf="@+id/ivGps"
                    android:ellipsize="end"

                    android:text="Rua Zeferino Vicente Almeida, 108, Vila Ieda CEP 79100-000 Campo Grande MS" />

            </RelativeLayout>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/lyDadosCobranca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


            <RelativeLayout
                android:id="@+id/lyDatas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
