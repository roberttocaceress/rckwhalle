        <RelativeLayout
            android:id="@+id/rltNovoPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_alignParentBottom="true">

            <Button
                android:id="@+id/btnNovoPedido"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/style_button"
                android:elevation="48dp"
                android:gravity="center_horizontal|center_vertical"
                android:text="+"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="25sp" />

            <LinearLayout
                android:id="@+id/lytNovoPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/btnNovoPedido"
                android:layout_marginEnd="-20dp"
                android:layout_marginRight="-20dp"
                android:layout_marginBottom="2dp"
                android:layout_toStartOf="@+id/btnNovoPedido"
                android:layout_toLeftOf="@+id/btnNovoPedido"
                android:background="@drawable/borda_edittext_preto_cinza"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtNovoPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginRight="10dp"
                    android:text="Novo pedido"
