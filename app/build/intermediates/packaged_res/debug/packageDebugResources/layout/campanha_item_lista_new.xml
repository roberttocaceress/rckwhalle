<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"
    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1.2dp"
        android:layout_marginTop="0.1dp"
        android:layout_marginRight="1.2dp"
        android:layout_marginBottom="1.4dp"
        android:background="@drawable/borda_layout_pedido"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1.2dp"
            android:layout_marginTop="0.1dp"
            android:layout_marginRight="1.2dp"
            android:layout_marginBottom="1.4dp"

            android:orientation="vertical">

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Produto"
                android:textColor="#000000"
                android:textSize="12dp"
                android:textAlignment="center"/>
            <TextView
                android:id="@+id/txtIdProdutoLinha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:focusable="false"
                android:text="ID"
                android:textColor="#000000"
                android:textSize="12dp"/>
            <TextView
                android:id="@+id/edtNomeProdutoLinha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:focusable="false"
                android:text="Produto campanha"
                android:textColor="#000000"
                android:textSize="16dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txtTipoCampanha1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="6dp"
                    android:textColor="#000000"
                    android:textSize="14dp"
                    android:text="Compre: " />

                <TextView
                    android:id="@+id/edtQuantidadeLinha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="6dp"
                    android:textColor="#000000"
                    android:textSize="14dp"
                    android:text="0.00"/>

            </LinearLayout>



        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1.2dp"
            android:layout_marginTop="0.1dp"
            android:layout_marginRight="1.2dp"
            android:layout_marginBottom="1.4dp"

            android:orientation="vertical">
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Brinde"
                android:textColor="#000000"
                android:textSize="12dp"
                android:textAlignment="center"/>


            <TextView
                android:id="@+id/txtIdProdutoBrinde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:focusable="false"
                android:text="ID"
                android:textColor="#000000"
                android:textSize="12dp"/>
            <TextView
                android:id="@+id/edtNomeProdutoBrinde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:focusable="false"
                android:text="Produto brinde"
                android:textColor="#000000"
                android:textSize="16dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txtTipoCampanha2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="6dp"
                    android:text="Ganhe: "
                    android:textColor="#000000"
                    android:textSize="14dp" />
                <TextView
                    android:id="@+id/edtQuantidadeBrinde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="6dp"
                    android:textColor="#000000"
                    android:textSize="14dp"
                    android:text="0.00"/>


            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>
