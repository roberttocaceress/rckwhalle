<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/branco"
    android:orientation="vertical"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivIconeVisita"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_shadow_2025"
            android:padding="6dp"
            android:src="@drawable/img_avatar_empresa"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/ivIconeVisita"
            android:layout_toStartOf="@id/vStatusCirculoVisita"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemExpansaoRazao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Razão Social do Cliente"
                android:textColor="@color/colorText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemExpansaoFantasia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome Fantasia"
                android:textColor="@color/colorText"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemExpansaoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--/--/---- --:--"
                android:textColor="@color/colorText"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- CIRCULO PEQUENO DE STATUS (VERDE = POSITIVADO / VERMELHO = NÃO VENDA) -->

    </RelativeLayout>



</LinearLayout>
