<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_cadastro_cliente9_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".activity.CadastroClienteMain">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroolView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD: OBSERVAÇÕES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Informações Adicionais"
                        android:textColor="@color/preto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Observações de Faturamento -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="Observações para Faturamento"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtobsFat"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:gravity="top"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:maxLength="300"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Observações Financeiras -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Observações Financeiras"
                        android:textColorHint="@color/preto"
                        app:hintTextColor="@color/preto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtObsFinancas"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:gravity="top"
                            android:inputType="textCapCharacters|textMultiLine"
                            android:maxLength="300"
                            android:textColor="@color/preto" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botão de Finalização Padronizado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/colorPrimary"
                android:letterSpacing="0.05"
                android:text="FINALIZAR CADASTRO"
                android:textAllCaps="true"
                android:textColor="@color/branco"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_salvar_new"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/branco" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
