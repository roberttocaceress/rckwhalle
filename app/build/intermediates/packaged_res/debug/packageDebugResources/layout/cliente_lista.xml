<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"
    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="0.6dp"
        android:layout_marginTop="0.1dp"
        android:layout_marginRight="0.6dp"
        android:layout_marginBottom="1.4dp"
        android:background="@drawable/borda_layout_cliente"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/lyCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.6dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="0.6dp"
            android:layout_marginBottom="1.4dp"

            android:padding="5dp">

            <ImageView
                android:id="@+id/imStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/nomeListaCliente"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="5dp"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/imgFinanceiroVencido"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/nomeListaCliente"

                android:layout_marginTop="7dp"
                android:layout_marginBottom="5dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_toLeftOf="@+id/imStatus" />


            <ImageView
                android:id="@+id/imgClienteBloqueado"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/nomeListaCliente"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="5dp"
                android:layout_toLeftOf="@+id/imgFinanceiroVencido" />


            <ImageView
                android:id="@+id/imgPromocaoCliente"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_above="@+id/imStatus"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="5dp" />


            <ImageView
                android:id="@+id/imgFinanceiroVencendo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_above="@+id/imStatus"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_toLeftOf="@+id/imgFinanceiroVencido"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgPedidoAnalise"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_above="@+id/imStatus"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_toLeftOf="@+id/imgFinanceiroVencido" />



            <TextView
                android:id="@+id/telefoneCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewNomeFantasia"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="12dp" />

            <LinearLayout
                android:id="@+id/lyCnpjCidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/telefoneCliente"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cnpjCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:text="00.000.000/0000-00"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/cidadeCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:text="-------"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textSize="12dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/idCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lyCnpjCidade"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text="Cod: 0000"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/nomeListaCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/textViewNomeFantasia"
                android:layout_marginRight="4dp"
                android:layout_toLeftOf="@+id/imgPedidoAnalise"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:textColor="#000000"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/txtCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomeTabelaPreco"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="12dp"/>

            <TextView
                android:id="@+id/nomeTabelaPreco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/idCliente"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/txtSegmento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtCategoria"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="12dp"/>



            <TextView
                android:id="@+id/txtDataUltimaCompra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imStatus"
                android:layout_alignBaseline="@+id/idCliente"
                android:layout_alignBottom="@+id/idCliente"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:maxLines="1"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/txtClienteAguarda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtDataUltimaCompra"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:text="Cliente aguardando análise para efetivação"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textSize="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewNomeFantasia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomeListaCliente"
                android:layout_alignParentStart="true"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"

                android:layout_toLeftOf="@+id/imgClienteBloqueado"

                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:textSize="16dp" />

        </RelativeLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="2dp"

            android:background="@color/colorPrimaryTransparente60" />
        <LinearLayout
            android:id="@+id/botoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/lyDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnDownload"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_download_cliente_new" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lyChamada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnChamada"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_telefone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnGps"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_localizacao" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnEmail"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_mail" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyFinanceiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnFinanceiro"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_financeiro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyNovoPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnNovoPedido"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_cliente_pedido" />
            </LinearLayout>





        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>