<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/branco">

    <LinearLayout
        android:id="@+id/lyCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/itemView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Miolo Central para Tablet -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeListaCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="RAZÃO SOCIAL DO CLIENTE"
                    android:textColor="@color/preto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:minLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/textViewNomeFantasia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Nome Fantasia"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- ID e CNPJ (Sem ícone) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_id_card_2026"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/idCliente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="ID: 0000"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/cnpjCliente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00.000.000/0000-00"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Endereço Tablet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cidadeCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:text="Endereço Completo"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:minLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Telefone/Whats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/telefoneCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:text="(00) 0000-0000"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Categorias sem ícone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categoria"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSegmento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Segmento"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Tabela e Última Compra destaque -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nomeTabelaPreco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tabela"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDataUltimaCompra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Não compra há X dias"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtClienteAguarda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_status_vermelho"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="AGUARDANDO ANÁLISE"
                    android:textColor="#B91C1C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Status Painel -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|top"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgClienteBloqueado"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgFinanceiroVencido"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgFinanceiroVencendo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgPedidoAnalise"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgPromocaoCliente"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imStatus"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divisor Sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33999999" />

        <!-- Barra de Ações -->
        <LinearLayout
            android:id="@+id/botoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/lyDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <Button
                    android:id="@+id/btnDownload"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/ic_download_cliente_2025" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyChamada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <Button
                    android:id="@+id/btnChamada"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/ic_baseline_cliente_telefone_2025" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyGps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <Button
                    android:id="@+id/btnGps"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@mipmap/ic_localizacao" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyFinanceiro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <Button
                    android:id="@+id/btnFinanceiro"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@mipmap/ic_financeiro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyNovoPedido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <Button
                    android:id="@+id/btnNovoPedido"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/ic_novopedido_cliente_2025" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divisor final reduzido -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.3dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33999999" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
