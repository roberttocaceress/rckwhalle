<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layoutMain"
    tools:context=".activity.ActivityConfiguracao">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbl_config"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_horizontal"
        android:minHeight="?attr/actionBarSize"
        android:textAlignment="center"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="-4dp">

        <TextView
            android:id="@+id/toolbar_title"
            style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="CONFIGURAÇÃO"
            android:textColor="@color/branco"
            android:textSize="16sp" />
    </androidx.appcompat.widget.Toolbar>


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbl_config">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginRight="6dp"
                        android:gravity="center_horizontal"
                        android:text="Conexão Rede Externa(internet)"
                        android:textColor="@color/preto">

                    </TextView>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"

                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_ip_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="IP/URL"
                            android:inputType="textUri"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"

                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_porta_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="PORTA"
                            android:inputType="number"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"

                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_ip_1_descricao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="DESCRIÇÃO"
                            android:inputType="text"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginRight="6dp"
                        android:gravity="center_horizontal"
                        android:text="Conexão Rede Local(empresa)"
                        android:textColor="@color/preto">

                    </TextView>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"
                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_ip_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="IP/URL"
                            android:inputType="textUri"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"

                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_porta_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="PORTA"
                            android:inputType="number"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:textColorHint="@color/preto"
                        app:passwordToggleTint="@color/preto">

                        <EditText
                            android:id="@+id/edt_url_ip_2_descricao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="DESCRIÇÃO"
                            android:inputType="text"
                            android:textColor="@color/preto"
                            android:textColorHint="@color/preto"
                            android:textColorLink="@color/preto"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:gravity="center_horizontal"
                android:text="Tempo limte conexão API"
                android:textColor="@color/preto">

            </TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="6dp"
                    android:textColorHint="@color/preto"
                    app:passwordToggleTint="@color/preto">

                    <EditText
                        android:id="@+id/edt_time_conn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:hint="T. conexão"
                        android:inputType="textUri"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/preto"
                        android:textColorLink="@color/preto"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="6dp"
                    android:textColorHint="@color/preto"
                    app:passwordToggleTint="@color/preto">

                    <EditText
                        android:id="@+id/edt_time_read"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:hint="T. leitura"
                        android:inputType="textUri"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/preto"
                        android:textColorLink="@color/preto"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="6dp"
                    android:textColorHint="@color/preto"
                    app:passwordToggleTint="@color/preto">

                    <EditText
                        android:id="@+id/edt_time_write"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:hint="T. gravação"
                        android:inputType="textUri"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/preto"
                        android:textColorLink="@color/preto"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/chk_con_segura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Conexão segura(https)"
                        android:textColor="@color/preto" />

                    <CheckBox
                        android:id="@+id/chk_usa_campanha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com campanha(s) no pedido"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_dscto_reais"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com desconto em valor no pedido(R$)"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_limite_cred"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com análise/limite de crédito"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_pre_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com pré-pedido"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_confirma_prazo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Obrigátorio confirmação de prazo"
                        android:textColor="@color/preto"/>
                    <CheckBox
                        android:id="@+id/chk_cadastra_cliente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Permite cadastrar cliente"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_atualiza_lista_ped_exprtado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Atualiza lista de pedidos exportados"
                        android:textColor="@color/preto"

                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/chk_usa_unidade_manut_estoque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Visualiza unidade de manutenção de estoque"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_paginacao_dados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com paginação de dados"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_icms_st"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Calcula icms no item do pedido"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_desc_auto_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Desconto automatico no item do pedido"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_sinc_auto_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Sincronia automatica de dados"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_usa_verba_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Trabalha com verba no pedido"
                        android:textColor="@color/preto"

                        />

                    <CheckBox
                        android:id="@+id/chk_confima_sincronia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/preto"
                        android:buttonTint="@color/preto"
                        android:text="Confirma sincronia automatizada"
                        android:textColor="@color/preto"

                        />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:gravity="center_horizontal"
                android:text="Tipos de pesquisa(produto/pedido)"
                android:textColor="@color/preto"/>

            <TextView
                android:id="@+id/txvOrdemCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:gravity="center_horizontal"
                android:text="Ordem padrão(Nome/Razao Social)"
                android:textColor="@color/preto">

            </TextView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="7dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/swtPesquisaGrupo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:checked="true"
                        android:text="Pesquisa padrao(grupo de produto)"
                        android:textAlignment="textStart"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:theme="@style/Switch" />

                    <Switch
                        android:id="@+id/swtPesquisaSubGrupo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:checked="true"
                        android:text="Pesquisa padrao(sub-grupo de produto)"
                        android:textAlignment="textStart"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:theme="@style/Switch" />

                    <Switch
                        android:id="@+id/swtPesquisaLinha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:checked="true"
                        android:text="Pesquisa padrao(linha de produto)"
                        android:textAlignment="textStart"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:theme="@style/Switch" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <Switch
                        android:id="@+id/swtMarcaProdutoJaComprado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:checked="true"
                        android:text="Destaca produto vendido para o cliente"
                        android:textAlignment="textStart"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:theme="@style/Switch" />

                    <Switch
                        android:id="@+id/swtPesquisaTodosPedidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="2dp"
                        android:checked="true"
                        android:text="Pesquisa todos pedidos"
                        android:textAlignment="textStart"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:theme="@style/Switch" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:gravity="center_horizontal"
                android:text="Tipos de lista(cliente/produto/cobrança/pedido)"
                android:textColor="@color/preto"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="7dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/swtGiraTelaCliente"
