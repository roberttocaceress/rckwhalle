<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title=" "
            app:subtitle="Dashboard de Metas e Progresso"/>

        <TextView
            android:id="@+id/tvDataPesquisa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Processado em: --/--/---- --:--"
            android:textColor="@color/colorText"
            android:textSize="10sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar" />

        <TextView
            android:id="@+id/tvAvisoRolar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:text="Deslize para baixo para ver mais informações ▼"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDataPesquisa" />

        <ScrollView
            android:id="@+id/scrollViewDashboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAvisoRolar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- FILTRO E KPIs (LADO A LADO) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFiltroGlobal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/branco"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:id="@+id/btnSelecionarMesAnoGlobal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/icCalendarGlobal"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/icCalendarGlobal"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PERÍODO"
                                    android:textColor="@color/colorText"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMesAnoReferencia"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Maio / 2026"
                                    android:textColor="@color/preto"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONSOLIDADO" android:textSize="9sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiReal1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#009688" android:textSize="13sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiMeta1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meta: R$ 0,00" android:textSize="8sp" android:textStyle="italic" />
                                    <ProgressBar android:id="@+id/pbKpi1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:progressTint="#009688" />
                                    <TextView android:id="@+id/tvKpiPerc1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0% atingido" android:textSize="10sp" android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GRUPOS" android:textSize="9sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiReal3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#9C27B0" android:textSize="13sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiMeta3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meta: R$ 0,00" android:textSize="8sp" android:textStyle="italic" />
                                    <ProgressBar android:id="@+id/pbKpi3" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:progressTint="#9C27B0" />
                                    <TextView android:id="@+id/tvKpiPerc3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0% atingido" android:textSize="10sp" android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EMPRESA" android:textSize="9sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiReal2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="#2196F3" android:textSize="13sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvKpiMeta2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meta: R$ 0,00" android:textSize="8sp" android:textStyle="italic" />
                                    <ProgressBar android:id="@+id/pbKpi2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:progressTint="#2196F3" />
                                    <TextView android:id="@+id/tvKpiPerc2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00% da empresa" android:textSize="10sp" android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- GRÁFICOS EM GRID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- COLUNA 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- PERFORMANCE SEMANAL -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardGrafico1"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
                                    <TextView android:id="@+id/tvTituloSemanal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Semanal" android:textSize="13sp" android:textStyle="bold" />
                                    <ImageView android:id="@+id/btnRefreshSemanal" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_sincroniza_hora" app:tint="@color/colorText" />
                                    <ImageView android:id="@+id/btnCalendarioSemanal" android:layout_width="20dp" android:layout_height="20dp" android:layout_toStartOf="@id/btnRefreshSemanal" android:layout_marginEnd="8dp" android:src="@drawable/ic_calendar" app:tint="@color/colorText" />
                                </RelativeLayout>
                                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                                    <LinearLayout android:id="@+id/lyt1" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="4dp">
                                        <com.github.mikephil.charting.charts.BarChart android:id="@+id/barChart1" android:layout_width="match_parent" android:layout_height="match_parent" />
                                    </LinearLayout>
                                    <LinearLayout android:id="@+id/lyt2" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/branco" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                                        <ProgressBar android:id="@+id/progressBar1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:indeterminate="true" />
                                        <TextView android:id="@+id/progressTitle1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sincronizando..." android:textSize="10sp" />
                                    </LinearLayout>
                                </FrameLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- PERFORMANCE MÊS -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardGrafico3"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mensal" android:textSize="13sp" android:textStyle="bold" />
                                    <ImageView android:id="@+id/btnRefreshMensal" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_sincroniza_hora" app:tint="@color/colorText" />
                                </RelativeLayout>
                                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                                    <LinearLayout android:id="@+id/lyt3" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="4dp">
                                        <com.github.mikephil.charting.charts.BarChart android:id="@+id/barChart2" android:layout_width="match_parent" android:layout_height="match_parent" />
                                    </LinearLayout>
                                    <LinearLayout android:id="@+id/lyt4" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/branco" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                                        <ProgressBar android:id="@+id/progressBar2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:indeterminate="true" />
                                        <TextView android:id="@+id/progressTitle2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sincronizando..." android:textSize="10sp" />
                                    </LinearLayout>
                                </FrameLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- COLUNA 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- PERFORMANCE POR GRUPO -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardGrafico2"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
                                    <TextView android:id="@+id/tvTituloGrupo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Por Grupo" android:textSize="13sp" android:textStyle="bold" />
                                    <ImageView android:id="@+id/btnRefreshGrupo" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_sincroniza_hora" app:tint="@color/colorText" />
                                </RelativeLayout>
                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1">
                                    <LinearLayout android:id="@+id/lyt5" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="4dp">
                                        <com.github.mikephil.charting.charts.BarChart android:id="@+id/barChart3" android:layout_width="match_parent" android:layout_height="match_parent" />
                                    </LinearLayout>
                                    <LinearLayout android:id="@+id/lyt6" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/branco" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                                        <ProgressBar android:id="@+id/progressBar3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:indeterminate="true" />
                                        <TextView android:id="@+id/progressTitle3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sincronizando..." android:textSize="10sp" />
                                    </LinearLayout>
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/tvAvisoScrollGrupo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:gravity="center"
                                    android:text="← Deslize para ver mais →"
                                    android:textColor="#777777"
                                    android:textSize="10sp"
                                    android:textStyle="italic" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- ESPAÇO VAZIO -->
                        <View android:layout_width="match_parent" android:layout_height="260dp" android:layout_margin="4dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/lytGlobalLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp">
            <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminateTint="@color/branco" />
            <TextView android:id="@+id/tvGlobalLoadingTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Processando..." android:textColor="@color/branco" android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorPrimary"
        app:itemTextColor="@android:color/white"
        app:itemIconTint="@color/branco" />
</androidx.drawerlayout.widget.DrawerLayout>
