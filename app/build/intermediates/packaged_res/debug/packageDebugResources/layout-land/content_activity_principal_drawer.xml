<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:baselineAligned="false">

        <!-- LADO ESQUERDO: MENU DE BOTÕES (GRID 2x4) -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.45"
            app:shimmer_duration="900">

            <LinearLayout
                android:id="@+id/activity_principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivInternet"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end"
                    android:background="@mipmap/ic_sem_internet"
                    android:visibility="gone" />

                <!-- LINHA 1 (4 BOTÕES) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnPedido" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_pedidos" />
                    <Button android:id="@+id/btnSincroniza" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_sincroniza_servidor" />
                    <Button android:id="@+id/btnPedidoPendente" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_pedido_pendente" />
                    <Button android:id="@+id/btnPedidoFinalizado" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_pedido_finalizado" />
                </LinearLayout>

                <!-- LINHA 2 (4 BOTÕES) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <Button android:id="@+id/btnCliente" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_clientes" />
                    <Button android:id="@+id/btnProduto" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@mipmap/ic_produtos" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <Button android:id="@+id/btnProspectNovo" android:layout_width="70dp" android:layout_height="70dp" android:background="@mipmap/ic_conta_receber" />
                        <TextView android:id="@+id/txvProspectNovo" android:layout_width="70dp" android:layout_height="2dp" android:background="@color/colorAccentDark" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/lytCampanhas" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="0dp" app:cardElevation="0dp">
                            <Button android:id="@+id/btnCampanha" android:layout_width="70dp" android:layout_height="70dp" android:background="@mipmap/ic_campanhas" />
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="70dp" android:layout_height="2dp" android:background="@color/colorAccentDark" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txvAguarde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aguarde..."
                    android:textAlignment="center"
                    android:textColor="@color/preto"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- DIVISOR VERTICAL -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#E2E8F0" />

        <!-- LADO DIREITO: DASHBOARD KPIs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvUltimaAtualizacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Atualizado: --/-- --:--"
                    android:textColor="@color/colorText"
                    android:textSize="8sp"
                    android:textStyle="italic" />
                <ImageButton
                    android:id="@+id/btnOcultarBI"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_action_visibility_white"
                    app:tint="@color/colorText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytConteudoBI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <!-- CARD 1: SEMANA -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/tvTituloMetaSemana" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="META SEMANA" android:textColor="@color/colorPrimary" android:textSize="9sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPorcentagemSemana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#E67E22" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvValoresSemana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/preto" android:textSize="11sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/progressSemana" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progress="0" android:progressTint="#E67E22" />
                        <TextView android:id="@+id/tvRankingSemana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ranking: --" android:textColor="@color/preto" android:textSize="8sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD 2: MÊS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/tvTituloMetaMes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="META MÊS" android:textColor="@color/colorPrimary" android:textSize="9sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPorcentagemMes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/colorPrimary" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvValoresMes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/preto" android:textSize="11sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/progressMes" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progress="0" android:progressTint="@color/colorPrimary" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                            <TextView android:id="@+id/tvRankingMes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ranking: --" android:textColor="@color/preto" android:textSize="8sp" />
                            <TextView android:id="@+id/tvFaltaMes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Falta: --" android:textColor="#2E7D32" android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD 3: OPERACIONAL -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:weightSum="4">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FATURADOS"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvPedidosFaturados"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="42"
                                    android:textColor="#2E7D32"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DEVOLVIDOS"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvPedidosDevolvidos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#E91E63"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CANCELADOS"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvPedidosCancelados"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="03"
                                    android:textColor="#C62828"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CLIENTES NOVOS"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvNovosClientes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="05"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
                            <TextView android:id="@+id/tvPositivacao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pos: --" android:textSize="8sp" />
                            <TextView android:id="@+id/tvTicketMedio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tkt: --" android:gravity="end" android:textSize="8sp" />
                        </LinearLayout>

                        <TextView android:id="@+id/tvPedidosATransmitir" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PENDENTE: R$ 0,00" android:textColor="#991B1B" android:gravity="center" android:textSize="9sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnOutrosIndicadores"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/borda_botao_mensagem"
                    android:backgroundTint="#F8FAFC"
                    android:text="INDICADORES"
                    android:textColor="@color/colorPrimary"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
