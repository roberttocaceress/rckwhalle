<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    tools:context="com.example.rcksuporte05.rcksistemas.activity.MainActivity">


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <Button
            android:id="@+id/btnAjuda"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="end|top"
            android:layout_marginBottom="10dp"
            android:background="@color/colorPrimary"
            android:drawableRight="@drawable/ic_help_new"
            android:text="Ajuda"
            android:textAlignment="textEnd"
            android:textColor="@color/branco"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txvBemVindo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:text="Olá. Seja bem vindo! Informe seu usuário/email e senha para prosseguir."
            android:textColor="@color/branco"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="24dp"
                android:layout_weight="1"
                android:textColorHint="@color/branco"
                app:counterEnabled="true"
                app:errorEnabled="true"
                app:passwordToggleTint="@color/branco">

                <EditText
                    android:id="@+id/edtLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"

                    android:hint="Usuário/email"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/branco"
                    android:textColorLink="@color/branco"
                    android:textSize="20sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_weight="1"
                android:textColorHint="@color/branco"

                app:counterEnabled="true"
                app:errorEnabled="true"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/branco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLogin"
                    android:layout_centerInParent="true"
                    android:layout_weight="1"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/branco"
                    android:textSize="20sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/colorPrimary"
                android:drawableTop="@drawable/ic_main_avancar_new"
                android:visibility="invisible" />

        </LinearLayout>


        <Button
            android:id="@+id/btnBiometria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableTop="@drawable/ic_main_biometria_land"
            android:text="Login biométrico"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmallTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"

            android:visibility="invisible" />

        <TextView
            android:id="@+id/progressTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Aguarde enquanto validadamos os dados informádos..."
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="10sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btnInformacoesApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:drawableTop="@drawable/ic_ajuda_informacoes_new"
            android:text="Informações do app"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/branco"
            android:textSize="8sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecuperarSenha1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="Esqueceu a senha? "
            android:textAlignment="textEnd"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/btnRecuperarSenha2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="@string/underlined_text"
            android:textAlignment="textStart"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/branco" />
    </LinearLayout>


</RelativeLayout>