<resources>

    <!-- Base application theme. -->
    <style name="Theme.MeuTema" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- colorPrimary is used for the default action bar background -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">@color/colorAccent</item>


        <item name="colorControlNormal">@color/colorControlNormal</item>

        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar</item>
        <item name="materialAlertDialogTheme">@style/MeuMaterialDialogArredondado</item>
    </style>

    <style name="Theme.Dashboard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#F8FAFC</item>
    </style>

    <style name="Theme.Toolbar" parent="Theme.AppCompat.NoActionBar">
        <!-- colorPrimary is used for the default action bar background -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">@color/colorAccent</item>

        <!--Quando ativa o modo seleção nos recyclerview-->
        <item name="windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@color/bg_action_mode</item>

        <!-- You can also set colorControlNormal, colorControlActivated
             colorControlHighlight, and colorSwitchThumbNormal. -->

    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@color/bg_action_mode</item>
    </style>


    <!-- Base application theme. -->
    <style name="Theme.Dialogs" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- colorPrimary is used for the default action bar background -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">@color/colorAccent</item>

        <!-- You can also set colorControlNormal, colorControlActivated
             colorControlHighlight, and colorSwitchThumbNormal. -->

        <item name="colorControlNormal">@color/colorControlNormalAzul</item>

        <item name="android:textAppearance">@color/branco</item>

    </style>


    <style name="Theme.CriarDialog" parent="@android:style/Theme.Holo.Dialog">

        <item name="android:windowBackground">@color/branco</item>
        <item name="android:textAppearance">@color/colorAccent</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="android:switchPreferenceStyle">@null</item>

        <item name="android:buttonBarStyle">@null</item>
        <item name="android:listPreferredItemPaddingLeft">56dip</item>
        <item name="android:listPreferredItemPaddingRight">56dip</item>
        <item name="android:listPreferredItemPaddingStart">56dip</item>
        <item name="android:listPreferredItemPaddingEnd">56dip</item>

    </style>

    <!-- Base application theme. -->
    <style name="Theme.MeuTemaPedido" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- colorPrimary is used for the default action bar background -->
        <item name="colorPrimary">@color/colorPrimaryCinza</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/colorPrimaryDarkCinza</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:colorBackground">@color/branco</item>

        <item name="android:textColor">#000000</item>
        <!-- You can also set colorControlNormal, colorControlActivated
             colorControlHighlight, and colorSwitchThumbNormal. -->

        <item name="colorControlNormal">@color/colorControlNormalAzul</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="android:actionModeBackground">@color/bg_action_mode</item>

    </style>

    <!-- Base application theme. -->
    <style name="Theme.Main" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- colorPrimary is used for the default action bar background -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">#000000</item>

        <!-- You can also set colorControlNormal, colorControlActivated
             colorControlHighlight, and colorSwitchThumbNormal. -->

        <item name="colorControlNormal">@color/colorControlNormal</item>

    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Button" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/corBotao</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:checkableBehavior">all</item>
    </style>

    <style name="ButtonSalvar" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">#58ae23</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:checkableBehavior">all</item>
    </style>

    <style name="txtStyle">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="subtitlePrincipal">
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.MeuTema.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MeuTema.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MeuTema.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Switch" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/colorPrimary</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#f1f1f1
        </item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">@color/colorPrimary
        </item>
    </style>

    <style name="CheckBox" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">#333333</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">@color/colorPrimary
        </item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">@color/colorPrimary
        </item>
    </style>

    <style name="Divider">
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="Divider.Horizontal" parent="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>

    </style>

    <style name="Divider.Vertical" parent="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="spinner_sku">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/border_spinner_sku</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:popupBackground">#DFFFFFFF</item>
    </style>

    <style name="MaterialTheme" parent="Theme.MaterialComponents.DayNight.Bridge">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/preto</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:gravity">center</item>
        <item name="buttonBarPositiveButtonStyle">@style/ThemeMaterialCalendarButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ThemeMaterialCalendarButton</item>
    </style>

    <style name="ThemeMaterialCalendarButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/colorPrimary</item>

    </style>

    <style name="PopupProdutoMenu" parent="@android:style/Widget.ListPopupWindow">
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHighlight">@color/branco</item>


    </style>

    <style name="TextViewNomeLista" parent="Theme.MeuTema">
       <item name="android:textColor">#000000</item>
       <item name="android:textSize">16sp</item>
       <item name="android:theme">@style/TextAppearance.AppCompat.Small</item>
    </style>
    <style name="TextViewNomeLista1" parent="Theme.MeuTema">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:theme">@style/TextAppearance.AppCompat.Small</item>
    </style>
    <style name="TextViewNomeLista2" parent="Theme.MeuTema">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
        <item name="android:theme">@style/TextAppearance.AppCompat.Small</item>
    </style>

    <style name="TextViewOutrosLista" parent="Theme.MeuTema">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextViewOutrosLista1" parent="Theme.MeuTema">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>

    </style>
    <style name="TextViewOutrosLista2" parent="Theme.MeuTema">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>

    </style>

    <style name="TextViewOutrosListaSmall" parent="Theme.MeuTema">

        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>
    </style>
    <style name="TextViewOutrosListaSmall1" parent="Theme.MeuTema">

        <item name="android:textSize">16sp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>

    </style>
    <style name="TextViewOutrosListaSmall2" parent="Theme.MeuTema">

        <item name="android:textSize">18sp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>

    </style>

    <style name="Base.Theme.MeuTemaDrawnerPadrao" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textSize">14sp</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="Base.Theme.MeuTemaDrawnerExtra1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textSize">16sp</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="Base.Theme.MeuTemaDrawnerExtra2" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textSize">18sp</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="MeuMaterialDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <!-- Isso garante que o atributo colorSurface exista neste contexto -->
        <item name="colorSurface">#FFFFFF</item>
    </style>
    <!-- Estilo para o Shape Arredondado -->
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item> <!-- Ajuste aqui o quão redondo deseja -->
    </style>

    <!-- Estilo para o Dialog -->
    <style name="MeuMaterialDialogArredondado" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.MediumComponent</item>
        <!-- Cor de fundo do Dialog -->
        <item name="android:windowBackground">@android:color/transparent</item>


        <!-- Centralizar o ícone e o título (estilo Material 3) -->

    </style>
    <!-- Estilo para Diálogos Material -->
    <style name="MaterialAlertDialog_Rounded"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">#20253D</item> <!-- Cor do texto (seu azul escuro) -->
        <item name="colorPrimary">#5A6794</item>    <!-- Cor dos botões (azul suave) -->

        <item name="materialAlertDialogBodyTextStyle">@style/MeuEstiloCorpoDialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card.Medium</item>
        <!-- Forçar estilo de botões TextButton -->
        <item name="buttonBarPositiveButtonStyle">@style/MeuBotaoDestaque</item>
        <item name="buttonBarNegativeButtonStyle">@style/MeuBotaoDestaque</item>
        <item name="buttonBarNeutralButtonStyle">@style/MeuBotaoDestaque</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Card.Medium" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- 2. Estilo para o botão POSITIVO (Visualizar) -->
    <style name="MeuBotaoDestaque" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/preto</item> <!-- Sua cor moderna -->
        <item name="android:textSize">14sp</item>      <!-- Tamanho do texto -->
        <item name="android:textAllCaps">true</item> <!-- Evita que o Android deixe tudo em maiúsculo -->
    </style>
    <style name="MeuEstiloCorpoDialog" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">16sp</item>           <!-- Tamanho da mensagem -->
        <item name="android:textColor">@color/preto</item>      <!-- Um tom cinza azulado mais suave -->
        <item name="android:lineSpacingExtra">4dp</item>    <!-- Melhora a leitura se o texto for longo -->
    </style>

    <!-- Tema específico para a nova tela de Login 2026 -->
    <style name="Theme.Login2026" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Tema para os Wizards de Cadastro Premium 2026 -->
    <style name="Theme.Wizard2026" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:textColorPrimary">@color/preto</item>
        <item name="android:textColorSecondary">@color/preto</item>
    </style>

</resources>
