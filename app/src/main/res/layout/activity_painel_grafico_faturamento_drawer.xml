<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:subtitle="Dashboard de Faturamento(6 MESES)" />

        <TextView
            android:id="@+id/tvDataPesquisa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Processado em: --/--/---- --:--"
            android:textColor="@color/colorText"
            android:textSize="10sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar" />

        <TextView
            android:id="@+id/tvAvisoRolar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:text="Deslize para baixo para ver mais informações ▼"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDataPesquisa" />

        <ScrollView
            android:id="@+id/scrollViewFaturamento"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAvisoRolar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- MINI KPI CARDS -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/linearLayout13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="VOLUME TOTAL (6M)"
                                    android:textColor="@color/colorText"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/vtotalVendasPeriodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="R$ 0,00"
                                    android:textColor="#009688"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TICKET MÉDIO"
                                    android:textColor="@color/colorText"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/vmedioVendasPeriodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="R$ 0,00"
                                    android:textColor="#9C27B0"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TICKETS/PEDIDOS"
                                    android:textColor="@color/colorText"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    />

                                <TextView
                                    android:id="@+id/qtotalVendasPeriodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#2196F3"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/lblDevolucoesPeriodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DEVOLUÇÕES"
                                    android:textColor="@color/colorText"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    />

                                <TextView
                                    android:id="@+id/vtotalDevolucaoPeriodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="R$ 0,00"
                                    android:textColor="#E91E63"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- GRAFICO 1: EVOLUÇÃO MENSAL -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrafico1"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/iconEv"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_analytics_24"
                                app:tint="#2196F3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/iconEv"
                                android:text="Evolução de Vendas (Semanal)"
                                android:textColor="@color/preto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnRefreshSemanal"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_sincroniza_hora"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:id="@+id/lyt1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingBottom="8dp">
                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChart3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/lyt2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/branco"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <ProgressBar
                                    android:id="@+id/progressBar1"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="48dp"
                                    android:indeterminate="true" />
                                <TextView
                                    android:id="@+id/progressTitle1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/colorText" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRAFICO 2: VOLUME DIÁRIO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrafico2"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/iconDiario"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/outline_show_chart_24"
                                app:tint="#009688" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/iconDiario"
                                android:text="Evolução de Vendas (Mensal)"
                                android:textColor="@color/preto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnRefreshMensal"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_sincroniza_hora"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:id="@+id/lyt3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingBottom="8dp">
                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChart1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/lyt4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/branco"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <ProgressBar
                                    android:id="@+id/progressBar2"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="48dp"
                                    android:indeterminate="true" />
                                <TextView
                                    android:id="@+id/progressTitle2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/colorText" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRAFICO 3: PARTICIPAÇÃO POR GRUPO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrafico3"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">
                            <ImageView
                                android:id="@+id/iconRankGrupo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_analytics_24"
                                app:tint="#FF9800" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:layout_marginEnd="1dp"
                                android:layout_toStartOf="@+id/btnAnaliseRankingGrupo"
                                android:layout_toEndOf="@id/iconRankGrupo"
                                android:text="Participação de Vendas por Grupo"
                                android:textColor="@color/preto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnAnaliseRankingGrupo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_toStartOf="@+id/btnRefreshGrupo"
                                android:layout_marginEnd="12dp"
                                android:src="@drawable/ic_lista_todos_drawner"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />

                            <ImageView
                                android:id="@+id/iconGrupo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_produto_sub_grupo"
                                app:tint="#9C27B0"
                                android:visibility="gone"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/iconGrupo"
                                android:text="Participação por Grupo"
                                android:textColor="@color/preto"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/btnRefreshGrupo"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_sincroniza_hora"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:id="@+id/lyt5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingBottom="8dp">
                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/pieChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/lyt6"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/branco"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <ProgressBar
                                    android:id="@+id/progressBar3"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="48dp"
                                    android:indeterminate="true" />
                                <TextView
                                    android:id="@+id/progressTitle3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/colorText" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRAFICO 4: RANKING DE FATURAMENTO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrafico4"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/iconRank"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_analytics_24"
                                app:tint="#FF9800" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@+id/btnAnaliseRanking"
                                android:layout_toEndOf="@id/iconRank"
                                android:text="Participação de Vendas por Cliente"
                                android:textColor="@color/preto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnAnaliseRanking"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_toStartOf="@+id/btnRefreshRanking"
                                android:layout_marginEnd="12dp"
                                android:src="@drawable/ic_lista_todos_drawner"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />

                            <ImageView
                                android:id="@+id/btnRefreshRanking"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_sincroniza_hora"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/colorText" />
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:id="@+id/lyt10"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingBottom="8dp">
                                <com.github.mikephil.charting.charts.HorizontalBarChart
                                    android:id="@+id/horChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/lyt11"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/branco"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <ProgressBar
                                    android:id="@+id/progressBar10"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="48dp"
                                    android:indeterminate="true" />
                                <TextView
                                    android:id="@+id/progressTitle10"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/colorText" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/lytGlobalLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/branco" />
            <TextView
                android:id="@+id/tvGlobalLoadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sincronizando faturamento..."
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorPrimary"
        app:itemTextColor="@android:color/white"
        app:itemIconTint="@color/branco" />
</androidx.drawerlayout.widget.DrawerLayout>
