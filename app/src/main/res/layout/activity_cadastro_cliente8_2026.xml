<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".activity.CadastroClienteMain">

    <!-- Lista de Anexos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAnexo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toTopOf="@+id/cardStatusAnexo"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botões Flutuantes (Ações) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddAnexCam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_camera"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddAnexos"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/branco" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddAnexos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/cardStatusAnexo"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/branco" />

    <!-- Card de Status e Total -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatusAnexo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnContinuar">

        <TextView
            android:id="@+id/edtTotalAnexos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:gravity="end"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Nenhum anexo registrado"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- Botão Continuar Padronizado -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinuar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/colorPrimary"
        android:letterSpacing="0.05"
        android:text="CONTINUAR 4/5"
        android:textAllCaps="true"
        android:textColor="@color/branco"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="8dp"
        app:elevation="2dp"
        app:icon="@drawable/ic_main_avancar_new"
        app:iconGravity="textEnd"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/branco"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
