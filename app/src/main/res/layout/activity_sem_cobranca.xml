    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivitySemCobranca"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbl_cobranca"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/Theme.Toolbar">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/buscaCobranca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:queryHint="Nome"
            tools:layout_conversion_absoluteHeight="48dp"
            tools:layout_conversion_absoluteWidth="48dp"
            tools:layout_editor_absoluteX="177dp"
            tools:layout_editor_absoluteY="4dp"
            app:showAsAction="always"/>
    </androidx.appcompat.widget.Toolbar>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAlignment="center"
        android:text="TOQUE PARA REAGENDAR NOVA VISITA"
        android:textSize="10sp"
        android:layout_marginTop="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_cobranca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="2dp"
        android:layout_weight="1" />

    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:layout_gravity="center"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/progress_title"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:gravity="center"
        android:text="Aguarde enquanto pesquisamos os dados..."
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="12sp"
        android:visibility="invisible"
        tools:text="Aguarde enquanto pesquisamos os dados..." />

