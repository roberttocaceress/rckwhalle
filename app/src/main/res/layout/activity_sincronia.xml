<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivitySincronia">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:paddingStart="12dp"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Voltar"
        app:titleTextColor="@color/branco" />

    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:theme="@style/Theme.MeuTemaPedido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_cliente"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Lista de clientes"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_produto"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Lista de produtos"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_cobrancas"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Lista de cobranças"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_fazer_checkin"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Checkin Local"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="invisible">

            <Switch
                android:id="@+id/id_opcao_pedidos_pendentes"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:maxLines="1"
                android:text="Subir pedidos pendentes"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_pedidos"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Lista de pedidos enviados"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_imagem_produto"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Lista de imagens/fotos"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_prospect"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:enabled="false"
                android:text="Prospects Pendentes"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_prospect_enviados"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:enabled="false"
                android:text="Prospects Enviados"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_visitas_pendentes"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:enabled="false"
                android:text="Visitas Pendentes"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_restaurar_pendentes"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Restaurar pedidos pendentes"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center">

            <Switch
                android:id="@+id/id_opcao_restaurar_clientes"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Restaurar clientes cadastrados"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:theme="@style/Switch" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytEncerrarRepetir"
        android:layout_width="347dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout5"
        app:layout_constraintStart_toStartOf="@+id/linearLayout5"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <TextView
            android:id="@+id/txvMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="SINCRONIA EFETUADA COM SUCESSO"
            android:textAlignment="center"
            android:textColor="@color/preto"
            android:textSize="18sp" />


        <Button
            android:id="@+id/btnEncerrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="Encerrar"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/btnRepetir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="Repetir"
            android:textColor="@color/branco" />
        <Button
            android:id="@+id/btnNovoApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:text="Atualizar versão do APP"
            android:textColor="@color/branco" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:drawableTop="@drawable/ic_cancelar"
            android:text="Cancelar"
            android:textColor="@color/branco" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:drawableTop="@drawable/ic_check_circle"
            android:text="Confirmar"
            android:textColor="@color/branco" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>