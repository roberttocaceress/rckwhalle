<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@color/branco"
    tools:context="com.example.rcksuporte05.rcksistemas.activity.ActivityPedidoEnviado">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPedidoEnviado"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Pesquisar enviados"
        tools:context=".activity.ActivityPedidoPendente"
        tools:layout_conversion_absoluteHeight="56dp"
        tools:layout_conversion_absoluteWidth="411dp">


        <androidx.appcompat.widget.SearchView
            android:id="@+id/buscaPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            app:queryHint="Razão social/Nº pedido"
            app:showAsAction="always"
            tools:layout_conversion_absoluteHeight="48dp"
            tools:layout_conversion_absoluteWidth="48dp"
            tools:layout_editor_absoluteX="177dp"
            tools:layout_editor_absoluteY="4dp" />

        <ImageView
            android:id="@+id/helpPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginRight="4dp"
            android:background="@drawable/ic_help_new" />


    </androidx.appcompat.widget.Toolbar>

    <Toolbar
        android:id="@+id/toolbarTotalPedidoDia"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:gravity="start"
        android:textAlignment="textStart"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_conversion_absoluteHeight="56dp"
        tools:layout_conversion_absoluteWidth="411dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/img_view_retornar"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="12dp"
                    app:srcCompat="@drawable/outline_arrow_back_24_white"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/img_view_avancar"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="12dp"
                    app:srcCompat="@drawable/ic_action_arrow_forward_white"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/txvTotalTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="3dp"
                android:text="Minhas vendas hoje"
                android:textSize="18sp"
                android:textColor="@color/branco"
                android:textAlignment="textStart"/>

            <TextView
                android:id="@+id/txvTotalPedidoDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:text="R$ 0,00"
                android:textSize="18sp"
                android:textColor="@color/branco"
                android:textAlignment="textStart"/>



        </LinearLayout>

    </Toolbar>


    <!--<androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPedidoEnviado"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimaryDark"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />-->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPedidoEnviados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="2dp"/>

    <EditText
        android:id="@+id/edtNumeroPedidoEnviado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="0dp"
        android:background="@color/branco"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:text="0: Pedidos Enviados"
        android:textColor="@color/preto"
        android:textSize="15sp" />


</LinearLayout>
