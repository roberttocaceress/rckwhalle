<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"

    android:layout_marginLeft="10dp"
    android:background="@color/branco">

    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginLeft="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginRight="2dp"

        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <RelativeLayout
            android:id="@+id/rlProdutoPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/idPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:text="1"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAnaliseEstoque"
                android:layout_width="22dp"
                android:layout_height="22dp"

                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="5dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/ic_check" />

            <TextView
                android:id="@+id/nomeListaProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginLeft="@dimen/activity_vertical_margin"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:scrollHorizontally="true"
                android:text="nomeListaProduto"
                android:textColor="#000000"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_marginTop="8dp"
                android:layout_alignBottom="@+id/nomeListaProduto"


                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="#999999"

                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginEnd="64dp"

                />

            <LinearLayout
                android:id="@+id/lytUnidPreco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomeListaProduto"
                android:layout_alignStart="@+id/nomeListaProduto"
                android:layout_alignLeft="@+id/nomeListaProduto"
                android:layout_marginRight="4dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewUnidadeMedida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="2.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:text="Unidade"
                    android:textAlignment="textStart"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/precoProduto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:scrollHorizontally="true"
                    android:text="precoProduto"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnExcluirProduto"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_below="@+id/lytUnidPreco"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/ic_delete_pedido" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_marginTop="0dp"
                android:layout_alignBottom="@+id/lytUnidPreco"

                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="#999999"

                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginEnd="64dp"

                />

            <TextView
                android:id="@+id/textViewCampanha"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_below="@+id/lytUnidPreco"

                android:layout_alignStart="@+id/lytUnidPreco"
                android:layout_alignLeft="@+id/lytUnidPreco"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:text="Campanha"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/nomeCampanha"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_below="@+id/lytUnidPreco"
                android:layout_marginEnd="30dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="5dp"
                android:layout_toLeftOf="@+id/btnExcluirProduto"
                android:layout_toEndOf="@+id/textViewCampanha"
                android:layout_toRightOf="@+id/textViewCampanha"
                android:ellipsize="end"
                android:scrollHorizontally="true"
                android:textColor="#000000"
                android:textSize="13sp" />



            <TextView
                android:id="@+id/txtDesconto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/idPosition"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:textSize="12sp" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.2dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:background="#50999999" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>