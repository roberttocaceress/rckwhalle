<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- CABEÇALHO DO DIÁLOGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/ic_baseline_check_circle_outline_24_color_primary"
            app:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHECK-IN REALIZADO COM SUCESSO"
            android:textColor="@color/preto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Escolha a intenção deste atendimento para o cliente:"
            android:textColor="@color/colorText"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- OPÇÃO 1: CONTINUAR PARA NOVO PEDIDO -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOpcaoPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/border_shadow_2025"
                android:padding="8dp"
                android:src="@drawable/ic_novopedido_cliente_2025"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EFETUAR NOVO PEDIDO"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Iniciar a digitação dos produtos do cliente"
                    android:textColor="@color/colorText"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_check_circle_outline_24_color_primary"
                app:tint="@color/colorPrimary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- OPÇÃO 2: REGISTRAR NÃO VENDA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOpcaoNaoVenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/border_shadow_2025"
                android:padding="8dp"
                android:src="@drawable/ic_alerta_mensagem_color_primary"
                app:tint="#D97706" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REGISTRAR NÃO VENDA"
                    android:textColor="#D97706"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Informar o motivo da não realização do pedido"
                    android:textColor="@color/colorText"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_alerta_mensagem_color_primary"
                app:tint="#D97706" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOTÃO CANCELAR -->
    <Button
        android:id="@+id/btnVoltarAtendimento"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:backgroundTint="#94A3B8"
        android:text="VOLTAR"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="6dp" />

</LinearLayout>