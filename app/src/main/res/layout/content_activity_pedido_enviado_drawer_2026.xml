<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_pedido_pendente"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_activity_pedido_drawer">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPedidoEnviado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Pesquisar pedidos"
        tools:context=".activity.ActivityPedidoPendente"
        tools:layout_conversion_absoluteHeight="56dp"
        tools:layout_conversion_absoluteWidth="411dp">


        <androidx.appcompat.widget.SearchView
            android:id="@+id/buscaPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            app:queryHint="Razão social/Nº pedido"
            app:showAsAction="always"
            tools:layout_conversion_absoluteHeight="48dp"
            tools:layout_conversion_absoluteWidth="48dp"
            tools:layout_editor_absoluteX="177dp"
            tools:layout_editor_absoluteY="4dp" />

        <ImageView
            android:id="@+id/helpPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginRight="4dp"
            android:background="@drawable/ic_help_new" />


    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorPrimary"
        android:gravity="start"
        android:textAlignment="textStart"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarPedidoEnviado">
        <LinearLayout
            android:id="@+id/lytTotalPedidoDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/img_view_retornar"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="12dp"
                    app:srcCompat="@drawable/outline_arrow_back_24_white"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/img_view_avancar"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="12dp"
                    app:srcCompat="@drawable/ic_action_arrow_forward_white"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/txvTotalTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="3dp"
                android:text="00/00/0000"
                android:textSize="18sp"
                android:textColor="@color/branco"
                android:textAlignment="textStart"/>

            <TextView
                android:id="@+id/txvTotalPedidoDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:text="R$ 0,00"
                android:textSize="18sp"
                android:textColor="@color/branco"
                android:textAlignment="textStart"/>



        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>


</androidx.constraintlayout.widget.ConstraintLayout>
