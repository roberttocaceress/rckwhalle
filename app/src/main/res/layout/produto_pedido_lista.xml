<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"

    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="vertical"
        android:background="@drawable/borda_layout_produto_pedido">


    <RelativeLayout
            android:id="@+id/rlProdutoPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/borda_layout_produto_pedido">

            <TextView
                android:id="@+id/idPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="5dp"
                android:text="1"
                android:textSize="10sp" />

        <TextView
            android:id="@+id/nomeListaProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/activity_vertical_margin"
            android:layout_marginLeft="@dimen/activity_vertical_margin"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:scrollHorizontally="true"
            android:text="nomeListaProduto"
            android:textColor="#000000"
            android:textSize="16sp" />

            <TextView
                android:id="@+id/precoProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomeListaProduto"
                android:layout_marginBottom="5dp"
                android:layout_toEndOf="@+id/textViewCampanha"
                android:layout_toRightOf="@+id/textViewCampanha"
                android:ellipsize="end"
                android:scrollHorizontally="true"
                android:text="precoProduto"
                android:textSize="13sp"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/textViewUnidadeMedida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/precoProduto"
                android:layout_alignBaseline="@+id/precoProduto"
                android:layout_alignStart="@+id/nomeListaProduto"
                android:layout_alignLeft="@+id/nomeListaProduto"
                android:layout_marginEnd="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:text="Unidade"
                android:textAlignment="center"
                android:textSize="13sp"
                android:textColor="#000000"/>


        <TextView
            android:id="@+id/textViewCampanha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewUnidadeMedida"

            android:layout_alignStart="@+id/textViewUnidadeMedida"
            android:layout_alignLeft="@+id/textViewUnidadeMedida"
            android:layout_marginEnd="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:text="Campanha"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="13sp" />


            <TextView
                android:id="@+id/nomeCampanha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/precoProduto"
                android:layout_marginBottom="5dp"
                android:layout_toEndOf="@+id/textViewCampanha"
                android:layout_toRightOf="@+id/textViewCampanha"
                android:layout_marginEnd="30dp"
                android:layout_marginRight="30dp"
                android:ellipsize="end"
                android:scrollHorizontally="true"
                android:textSize="13sp"
                android:layout_toLeftOf="@+id/btnExcluirProduto"
                android:textColor="#000000"/>

        <Button
            android:id="@+id/btnExcluirProduto"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/textViewUnidadeMedida"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/ic_delete_pedido" />

            <TextView
                android:id="@+id/txtDesconto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/idPosition"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:textSize="12sp"/>

        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>