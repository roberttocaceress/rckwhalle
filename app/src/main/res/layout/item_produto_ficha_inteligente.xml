<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProdutoFicha"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LADO ESQUERDO: IMAGEM COMPACTA DO PRODUTO (PADRÃO LISTA DE PRODUTOS / PEDIDO 1) -->
            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="top"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imageAnexo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_image_gallery_newww" />
            </androidx.cardview.widget.CardView>

            <!-- LADO DIREITO: INFORMAÇÕES E MÉTRICAS DO PRODUTO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- NOME DO PRODUTO -->
                <TextView
                    android:id="@+id/tvNomeFichaProduto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Arroz Tipo 1 5kg"
                    android:textColor="@color/preto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- MÉTRICAS DE GIRO: MÉDIA, PENÚLTIMA E ÚLTIMA -->
                <TextView
                    android:id="@+id/tvMetricasGiroProduto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Média: 30 cx/mês | Penúltima: 30 cx | Última: 0 cx 🚨"
                    android:textColor="@color/colorText"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- DIAGNÓSTICO COMERCIAL (DESTACADO SE EXISTIR) -->
        <TextView
            android:id="@+id/tvDiagnosticoProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FEF2F2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Diagnóstico: Produto não comprado no último pedido!"
            android:textColor="#DC2626"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <!-- BOTÃO DE AÇÃO RÁPIDA -->
        <Button
            android:id="@+id/btnAdicionarProdutoFicha"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/colorPrimary"
            android:paddingHorizontal="12dp"
            android:text="Adicionar 30 cx ao Pedido"
            android:textColor="@color/branco"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="6dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>