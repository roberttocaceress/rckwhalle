<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"

    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="vertical"
        android:background="@drawable/borda_layout_produto_pedido">


        <RelativeLayout
            android:id="@+id/rlProdutoPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/borda_layout_produto_pedido">

            <TextView
                android:id="@+id/idPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="5dp"
                android:text="1"
                android:textSize="10sp" />
            <Button
                android:id="@+id/btnAnaliseEstoque"
                android:layout_width="18dp"
                android:layout_height="18dp"

                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="0dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_check" />

            <TextView
                android:id="@+id/nomeListaProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginLeft="@dimen/activity_vertical_margin"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:scrollHorizontally="true"
                android:text="nomeListaProduto"
                android:textColor="#000000"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/lytUnidPreco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomeListaProduto"
                android:layout_alignStart="@+id/nomeListaProduto"
                android:layout_alignLeft="@+id/nomeListaProduto"
                android:layout_marginRight="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewUnidadeMedida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="2.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:text="Unidade"
                    android:textAlignment="textStart"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/precoProduto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:scrollHorizontally="true"
                    android:text="precoProduto"
                    android:textColor="#000000"
                    android:textSize="13sp" />


            </LinearLayout>

            <TextView
                android:id="@+id/textViewCampanha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lytUnidPreco"

                android:layout_alignStart="@+id/lytUnidPreco"
                android:layout_alignLeft="@+id/lytUnidPreco"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:text="Campanha"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/nomeCampanha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lytUnidPreco"
                android:layout_marginBottom="5dp"
                android:layout_toEndOf="@+id/textViewCampanha"
                android:layout_toRightOf="@+id/textViewCampanha"
                android:layout_marginEnd="30dp"
                android:layout_marginRight="30dp"
                android:ellipsize="end"
                android:scrollHorizontally="true"
                android:textSize="13sp"
                android:layout_toLeftOf="@+id/btnExcluirProduto"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnExcluirProduto"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_below="@+id/lytUnidPreco"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/ic_delete_pedido" />

            <TextView
                android:id="@+id/txtDesconto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/idPosition"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:textSize="12sp"/>

        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>