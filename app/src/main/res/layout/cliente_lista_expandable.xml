<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ly_lista_cliente_expand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <TextView
        android:id="@+id/txv_id_cliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewNomeFantasia"
        android:layout_marginStart="17dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="5dp"
        android:text="Cod: 0000"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="10dp"
        android:textColor="@color/preto"/>


    <ImageView
        android:id="@+id/img_status_cliente"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="13dp"
        android:layout_marginRight="13dp" />

    <TextView
        android:id="@+id/txv_data_ult_compra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/img_status_cliente"
        android:layout_alignBaseline="@+id/txv_id_cliente"
        android:layout_alignBottom="@+id/txv_id_cliente"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="13dp"
        android:layout_marginRight="13dp"
        android:maxLines="1"
        android:textSize="12dp"
        android:textColor="@color/preto"/>

    <TextView
        android:id="@+id/txv_nome_fantasia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="17dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="12dp"
        android:layout_marginRight="12dp"
        android:layout_toStartOf="@+id/txv_data_ult_compra"
        android:layout_toLeftOf="@+id/txv_data_ult_compra"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:textSize="12dp"
        android:textColor="@color/preto"/>

    <TextView
        android:id="@+id/txv_cliente_aguarda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txv_data_ult_compra"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="13dp"
        android:layout_marginRight="13dp"
        android:text="Cliente aguardando análise para efetivação"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="10dp"
        android:visibility="gone"
        android:textColor="@color/preto"/>

</RelativeLayout>