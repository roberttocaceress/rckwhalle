<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginTop="4dp"
    android:background="@color/branco"
    card_view:cardCornerRadius="4dp"
    card_view:cardElevation="3dp"   >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="2dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/img_avatar_pedidos" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRazaoSocial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Razão social"
                            android:textColor="#000000"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeFantasia"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Nome Fantasia"
                            android:textColor="#000000"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtNumeroPedido"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Pedido"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtDataEmissao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Emissão"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtDataEntrega"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Data entrega"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtValorProduto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="V. produto(s)"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtValorDesconto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="V. desconto(s)"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtValorTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="V. total"
                                android:textColor="#000000"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeVendedor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Representante/Vendedor"
                            android:textColor="#000000"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Button
                        android:id="@+id/btnConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="50dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginRight="50dp"
                        android:layout_marginBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_elevation"
                        android:clipToPadding="false"
                        android:drawableTop="@drawable/ic_check_circle"
                        android:text="Listar produto(s)"
                        android:textColor="#000000"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>