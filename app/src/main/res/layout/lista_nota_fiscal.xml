<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginRight="4dp"
    android:layout_marginLeft="10dp"
    android:background="@color/branco">
    <LinearLayout
        android:id="@+id/itemView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="0.6dp"
        android:layout_marginTop="0.1dp"
        android:layout_marginRight="0.6dp"
        android:layout_marginBottom="1.4dp"
        android:orientation="vertical">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="0.6dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="0.6dp"
            android:layout_marginBottom="1.4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txvNomeOperacao"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:text="OPERACAO"
                android:textAlignment="textStart"
                android:textColor="#000000"
                android:textSize="17sp"
                android:inputType="textMultiLine"/>

            <TextView
                android:id="@+id/txvValorOperacao"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:paddingRight="6dp"
                android:text="R$ 0.00"
                android:textAlignment="textEnd"
                android:textColor="#000000"
                android:textSize="17sp"
                android:inputType="textMultiLine"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/txvTotalDocs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:text="0 titulo(s)"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
