<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"
    android:background="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0.6dp"
        android:layout_marginTop="0.1dp"
        android:layout_marginRight="0.6dp"
        android:layout_marginBottom="1.4dp"
        android:background="@drawable/borda_layout_produto"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageAnexo"
            android:layout_width="101dp"
            android:layout_height="113dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_image_gallery_newww" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/idProduto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:text="0000"
                    android:textColor="#000000"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00000000000000"
                    android:textColor="#000000"
                    android:textSize="10sp"/>
                <RelativeLayout
                    android:id="@+id/itemView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/imageCarrinhoAzul"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="8dp"
                        android:layout_toStartOf="@+id/imageCarrinhoVerde"
                        android:layout_toLeftOf="@+id/imageCarrinhoVerde"
                        android:src="@drawable/ic_carrinho_azul"
                        android:visibility="invisible"/>

                    <ImageView
                        android:id="@+id/imageCarrinhoVerde"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="12dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:src="@drawable/ic_carrinho_verde"
                        android:visibility="invisible"/>
                </RelativeLayout>

            </LinearLayout>
            <TextView
                android:id="@+id/nomeListaProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Produto"
                android:textColor="#000000"
                android:textSize="16sp" />
            <Spinner
                android:id="@+id/spnSku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:paddingEnd="0dp"
                android:paddingRight="0dp"
                android:layout_marginLeft="0dp"
                android:layout_marginBottom="0dp"
                android:layout_marginTop="2dp"
                android:spinnerMode="dropdown"/>




        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>