<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:theme="@style/Theme.Toolbar"
    tools:context=".fragment.ActivityProdutoImage">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tb_produto_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Imagem(s) do produto"
        tools:context=".fragment.ActivityProdutoImage"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="1dp">


    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/textProdutoAnexo"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:text="TextView"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tb_produto_image"
        tools:text="Produto" />

    <ImageView
        android:id="@+id/imageProdutoAnexo1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="64dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textProdutoAnexo"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@android:color/background_light" />

</androidx.constraintlayout.widget.ConstraintLayout>