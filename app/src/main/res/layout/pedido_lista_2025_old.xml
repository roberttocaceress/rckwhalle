<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:layout_marginLeft="10dp"
    android:background="@color/branco">

    <LinearLayout
        android:id="@+id/item_lista_pedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/itemView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomeCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:singleLine="true"
                    android:text="nomeCliente"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="#000000"
                    android:textSize="16sp" />/>

                <TextView
                    android:id="@+id/txtFantasiaCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="fantasiaCliente"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textSize="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lyEmissao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/img_data_emissao"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/ic_baseline_data_emissao_pedido_2025"
                            android:tooltipText="Data de emissão!" />

                        <TextView
                            android:id="@+id/txtDataEmissaoPedido"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginRight="6dp"
                            android:layout_weight="1"
                            android:text="data missao"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textSize="12dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyEntrega"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/img_data_entrega"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/ic_baseline_data_emissao_pedido_2025"
                            android:tooltipText="Data de entrega/faturamento!" />

                        <TextView
                            android:id="@+id/txtDataEntrega"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_weight="1"
                            android:text="data entrega"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textSize="12dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/edtNumeroPedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:ellipsize="start"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingLeft="12dp"
                        android:singleLine="true"
                        android:text="Nº 00000"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyOperacao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCondicaoPagamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"

                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        tools:text="CondPagamento" />

                    <TextView
                        android:id="@+id/txtOperacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"

                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        tools:text="Operaçao" />

                    <TextView
                        android:id="@+id/txtMoeda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"

                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        tools:text="Moeda" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyTotal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:paddingEnd="6dp"
                        android:paddingRight="6dp"
                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        tools:text="Status" />


                    <TextView
                        android:id="@+id/txtPrecoPedido"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="4dp"

                        android:gravity="bottom"


                        android:paddingEnd="6dp"
                        android:paddingRight="6dp"
                        android:singleLine="true"
                        android:text="R$ 0.00"
                        android:textAlignment="textEnd"
                        android:textColor="#000000"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/abandonado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/botoes"
                android:layout_marginLeft="2.2dp"
                android:layout_marginRight="2.2dp"
                android:layout_marginBottom="0dp"
                android:background="#F34F4F"
                android:clipToPadding="false"
                android:gravity="center"

                android:visibility="invisible">

                <TextView
                    android:id="@+id/txvAbandonado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="ABANDONADO"
                    android:textColor="#FFFFFF"
                    android:textSize="15dp" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/cor"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="6dp"
            android:background="@color/colorPrimaryTransparente60" />

        <LinearLayout
            android:id="@+id/botoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnEnviar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_upload_pedido_2025"
                    android:tooltipText="Envia pedido para faturamento!" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnDuplic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_duplicar_pedido_2025"
                    android:tooltipText="Duplica pedido para ser faturado novamente!" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnExcluir"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_delete_pedido_2025"
                    android:tooltipText="Excluir o pedido!" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnCompartilhar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_compartilhar_pedido_2025"
                    android:tooltipText="Criar arquivo PDf para ser compartilhado!" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnCopiaSegura"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_action_copia_segura_pedido"
                    android:tooltipText="Criar cópia de segurança do pedido na nuvem!">

                </Button>

            </LinearLayout>

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center">

                <Button
                    android:id="@+id/btnLinhaTempo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_linhatempo_pedido_2025" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnRastreio"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_alvo_pedido" />
            </LinearLayout>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="0dp"
            android:background="#80999999" />

    </LinearLayout>

    <View
        android:id="@+id/corx"
        android:layout_width="2.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/cor_pedido_pendente"
        android:visibility="invisible" />

</androidx.cardview.widget.CardView>