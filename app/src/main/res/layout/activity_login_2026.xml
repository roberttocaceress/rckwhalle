<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"> <!-- Fundo branco puro -->

    <!-- Toolbar técnica mantida para o código Java não quebrar -->
    <View
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Logo Superior Arredondada (Dentro do Card) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="45dp"
                        app:cardElevation="2dp">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ajuda_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/logo_rck_new"
                            app:civ_border_color="#F1F5F9"
                            app:civ_border_width="1dp" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txvBemVindo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center"
                        android:text="Olá. Seja bem vindo!\nInforme seu login e senha para prosseguir."
                        android:textColor="#1E293B"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLogin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Login ou E-mail"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxStrokeColor="@color/preto"
                            app:hintTextColor="@color/preto"
                            app:startIconDrawable="@drawable/ic_person_color_primary_24_24">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtLogin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:imeOptions="actionNext"
                                android:textColor="@color/preto"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnBiometria"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            android:visibility="gone"
                            app:icon="@drawable/ic_main_avancar_biometria_foreground"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="32dp"
                            app:iconTint="@color/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputPwd"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Senha"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/preto"
                        app:hintTextColor="@color/preto"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock_color_primary_12_12">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtSenha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:textColor="@color/preto"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEntrar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:letterSpacing="0.05"
                        android:text="ENTRAR NO APP"
                        android:textAllCaps="true"
                        android:textColor="@color/branco"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="invisible"
                        app:cornerRadius="12dp"
                        app:elevation="2dp"
                        app:icon="@drawable/ic_main_avancar_new"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/branco" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRecuperarSenha1"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Esqueceu a senha?"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRecuperarSenha2"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recuperar"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/progressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Validando dados..."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- Rodapé de Ações Secundárias em formato de Card (Destaque) -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="8dp"
        app:cardElevation="12dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <Button
                android:id="@+id/btnAjuda"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AJUDA"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:icon="@drawable/ic_help_new"
                app:iconSize="20dp"
                app:iconTint="#64748B" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:background="#CBD5E1" />

            <Button
                android:id="@+id/btnInformacoesApp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOBRE"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:icon="@drawable/ic_ajuda_informacoes_new"
                app:iconSize="20dp"
                app:iconTint="#64748B" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
