<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- CARD 1: INFORMAÇÕES DA EMPRESA / CLIENTE -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInfoEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <!-- ÍCONE À ESQUERDA -->
                <ImageView
                    android:id="@+id/ivIconeEmpresa"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/border_shadow_2025"
                    android:padding="6dp"
                    android:src="@drawable/img_avatar_empresa"
                    app:tint="@color/colorPrimary" />

                <!-- DADOS À DIREITA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCheckInRazaoSocial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Razão Social da Empresa / Cliente"
                        android:textColor="@color/preto"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCheckInNomeFantasia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Nome Fantasia"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCheckInEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rua / Avenida, Nº 000 - Bairro - Cidade/UF"
                        android:textColor="@color/colorText"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: MAPA DE LOCALIZAÇÃO ATUAL -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMapaLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="LOCALIZAÇÃO ATUAL (MAPA)"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- CONTAINER / PLACEHOLDER DO MAPA -->
                <FrameLayout
                    android:id="@+id/flContainerMapa"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:background="#E2E8F0">

                    <ImageView
                        android:id="@+id/ivPlaceholderMapa"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_menu_gps_2025_black_24_24" />

                    <TextView
                        android:id="@+id/tvTextoPlaceholderMapa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="#80000000"
                        android:padding="6dp"
                        android:text="Carregando Mapa de Localização..."
                        android:textColor="@color/branco"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 3: COORDENADAS E PRECISÃO GPS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCoordenadasGPS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="COORDENADAS GPS DA VISITA"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- LATITUDE / LONGITUDE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LATITUDE"
                            android:textColor="@color/colorText"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCheckInLatitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-20.4697"
                            android:textColor="@color/preto"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LONGITUDE"
                            android:textColor="@color/colorText"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCheckInLongitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-54.6201"
                            android:textColor="@color/preto"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ALTITUDE / PRECISÃO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALTITUDE/PRECISÃO"
                            android:textColor="@color/colorText"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCheckInAltitudePrecisao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="530m / 5.0m"
                            android:textColor="@color/preto"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 4: REGISTRO FOTOGRÁFICO DO ESTABELECIMENTO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFotosEstabelecimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="FOTOS DO ESTABELECIMENTO"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- FOTO 1: ESTABELECIMENTO (FACHADA) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivFotoEstabelecimento"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="#F1F5F9"
                            android:padding="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/img_avatar_empresa"
                            app:tint="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Fachada Cadastrada"
                            android:textColor="@color/colorText"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- FOTO 2: BOTAO / CAPTURA DA CÂMERA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivCapturarFoto"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="#F1F5F9"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="20dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_add_novo_registro"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tirar Nova Foto"
                            android:textColor="@color/colorPrimary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÕES DE AÇÃO ALINHADOS VERTICALMENTE -->
        <Button
            android:id="@+id/btnConfirmarCheckIn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="CONFIRMAR CHECK-IN"
            android:textColor="@color/branco"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnCancelarCheckIn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#94A3B8"
            android:text="CANCELAR"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="6dp" />

    </LinearLayout>
</ScrollView>