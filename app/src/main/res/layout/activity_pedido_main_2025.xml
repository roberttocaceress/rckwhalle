<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_cadastro_cliente_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.rcksuporte05.rcksistemas.activity.ActivityPedidoMain">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarFragsPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="8dp"

        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <RelativeLayout
        android:id="@+id/lyHeaderCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.0dp"
        android:layout_marginBottom="0dp"
        android:background="@color/colorPrimary"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="0dp"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="0dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/ifCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/btnBuscaCliente"
            android:layout_alignBottom="@+id/btnBuscaCliente"
            android:layout_toStartOf="@+id/btnBuscaCliente"
            android:layout_toLeftOf="@+id/btnBuscaCliente"
            android:gravity="left"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="Toque aqui para selecionar o seu cliente"
                android:textAlignment="textStart"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                android:textColor="@color/branco" />

            <TextView
                android:id="@+id/txtNomeFantasia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textAlignment="textStart"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                android:textColor="@color/branco"
                android:textSize="10dp"
                android:visibility="visible" />

        </LinearLayout>

        <Button
            android:id="@+id/btnBuscaCliente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="1dp"
            android:background="@drawable/ic_busca_padrao_new" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/lyhistoricoFinanceiro"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0.1dp"
        android:background="@color/colorPrimary"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="5dp"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="5dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/ifHistoricoFinanceiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/btnBuscaHistoricoFinanceiro"
            android:layout_alignBottom="@+id/btnBuscaHistoricoFinanceiro"
            android:layout_toStartOf="@+id/btnBuscaHistoricoFinanceiro"
            android:layout_toLeftOf="@+id/btnBuscaHistoricoFinanceiro"
            android:gravity="left"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHistoricoFinanceiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="8dp"
                android:text="Histórico financeiro"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                android:textColor="@color/branco" />


        </LinearLayout>

        <Button
            android:id="@+id/btnBuscaHistoricoFinanceiro"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="1dp"
            android:background="@drawable/ic_financa_ver_receitas" />

    </RelativeLayout>

    <com.example.rcksuporte05.rcksistemas.util.SlidingTabLayout
        android:id="@+id/stl_tabsPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clipToPadding="false"

        android:paddingLeft="2dp"
        android:theme="@style/Theme.Toolbar"
        android:visibility="visible" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_tabsPedido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/layout_totais_rodape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:layout_weight="1"
            android:background="@drawable/layer_list_edittext_preto_2026"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalProdutos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="SUB-TOTAL"
                android:textColor="#000000"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/edtTotalProdutos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="00,00"
                android:textColor="#000000"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/layer_list_edittext_preto_2026"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalDescontos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="DESCONTOS"
                android:textColor="#000000"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/edtTotalDescontos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="00,00"
                android:textColor="#000000"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyvalorIcmsST"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/layer_list_edittext_preto_2026"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalIcmsST"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="ICMS ST"
                android:textColor="#000000"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/edtTotalIcmsST"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="center"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="00,00"
                android:textColor="#000000"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/layer_list_edittext_preto_2026"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalVenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="end"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="TOTAL"
                android:textColor="#000000"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/edtTotalVenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:gravity="end"
                android:paddingEnd="10dp"
                android:paddingRight="10dp"
                android:text="00,00"
                android:textColor="#000000"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
