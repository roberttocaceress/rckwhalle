<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_pedido_pendente"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@color/branco"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:layout_editor_absoluteY="25dp"
    tools:showIn="@layout/app_bar_activity_pedido_drawer">




    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:elevation="48dp"
        app:layout_constraintBottom_toTopOf="@+id/edtTotalPedidos"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnNovoPedido"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/style_button_2025"
            android:elevation="24dp"
            android:gravity="center_horizontal|center_vertical"
            android:text="+"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="25sp" />

        <LinearLayout
            android:id="@+id/lytInserirPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/btnNovoPedido"
            android:layout_marginEnd="-30dp"
            android:layout_marginRight="-30dp"
            android:layout_marginBottom="6dp"
            android:layout_toStartOf="@+id/btnNovoPedido"
            android:layout_toLeftOf="@+id/btnNovoPedido"
            android:background="@drawable/borda_edittext_preto_transparente"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginLeft="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginRight="30dp"
                android:text="Novo pedido "
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

        </LinearLayout>


    </RelativeLayout>

    <EditText
        android:id="@+id/edtTotalPedidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/branco"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:text="total"
        android:textColor="@color/preto"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="71dp">


    </FrameLayout>


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPedidoPendente"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:gravity="end"
        android:textAlignment="textEnd"
        android:theme="@style/Theme.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Pesquisar pendentes"
        tools:context=".activity.ActivityPedidoPendente"
        tools:layout_conversion_absoluteHeight="56dp"
        tools:layout_conversion_absoluteWidth="411dp">


        <androidx.appcompat.widget.SearchView
            android:id="@+id/buscaPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            app:queryHint="Razão social/Nº pedido"
            app:showAsAction="always"
            tools:layout_conversion_absoluteHeight="48dp"
            tools:layout_conversion_absoluteWidth="48dp"
            tools:layout_editor_absoluteX="177dp"
            tools:layout_editor_absoluteY="4dp" />

        <ImageView
            android:id="@+id/helpPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginRight="4dp"
            android:background="@drawable/ic_help_new" />


    </androidx.appcompat.widget.Toolbar>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaPedidosPendentes"
            android:layout_width="0dp"
            android:layout_height="0dp" app:layout_constraintBottom_toTopOf="@+id/edtTotalPedidos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarPedidoPendente"/>



</androidx.constraintlayout.widget.ConstraintLayout>
