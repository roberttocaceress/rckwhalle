<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ÁREA CENTRAL COM ROLAGEM FLEXÍVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1: HEADER - SAÚDE FINANCEIRA DO CLIENTE NA DATA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHeaderSaudeFinanceira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="4dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- NOME E DOCUMENTO DO CLIENTE -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivIconeClienteFicha"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/border_shadow_2025"
                            android:padding="6dp"
                            android:src="@drawable/img_avatar_empresa"
                            app:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/ivIconeClienteFicha"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFichaNomeCliente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Razão Social do Cliente"
                                android:textColor="@color/preto"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFichaDocCidadeCliente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="00.000.000/0001-00 • Campo Grande / MS"
                                android:textColor="@color/colorText"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- BANNER DE DATA E HORA DA ANÁLISE -->
                    <TextView
                        android:id="@+id/tvFichaDataHoraAnalise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F1F5F9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="📅 Análise realizada em: 27/04/2026 15:30"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- DIVISOR SUTIL -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E2E8F0" />

                    <!-- PAINEL FINANCEIRO DA DATA (2x2 GRID - SEM LIMITE UTILIZADO E SEM ÚLTIMA COMPRA) -->
                    <!-- LINHA 1: LIMITE CRÉDITO E SALDO DISPONÍVEL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LIMITE CRÉDITO"
                                android:textColor="@color/colorText"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFichaLimiteCredito"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 0,00"
                                android:textColor="@color/preto"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SALDO DISPONÍVEL"
                                android:textColor="@color/colorText"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFichaSaldoDisponivel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 0,00"
                                android:textColor="#16A34A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- LINHA 2: SALDO DEVEDOR E TICKET MÉDIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SALDO DEVEDOR"
                                android:textColor="@color/colorText"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFichaSaldoDevedor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 0,00"
                                android:textColor="@color/preto"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TICKET MÉDIO"
                                android:textColor="@color/colorText"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFichaTicketMedio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 0,00"
                                android:textColor="@color/colorPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD 2: ALERTA FINANCEIRO DA DATA DA ANÁLISE -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertaReposicao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FEF3C7"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvFichaAlertaReposicao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ALERTA DE INADIMPLÊNCIA NA DATA DE 27/04/2026 15:30: O cliente possuía títulos vencidos."
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- RODAPÉ FIXO NA PARTE INFERIOR (APENAS BOTÃO FECHAR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnFecharFichaInteligente"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="FECHAR"
            android:textColor="@color/branco"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="6dp" />
    </LinearLayout>

</LinearLayout>